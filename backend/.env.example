# Connect4 backend env template. Copy to backend/.env and fill in real values.
# Real .env is gitignored.

# --- Database (set automatically when running via docker-compose) ---
# Local dev (against the docker-compose postgres exposed on host port 5433):
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5433/connect4_arena
TEST_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5433/connect4_test
# Inside the docker network the host is `db` instead of localhost:5433.

# --- LLM provider keys (only set the ones you actually use) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=

# --- Optional CONNECT4_* overrides ---
# Every Settings field in backend/app/core/config.py is overridable here with
# the CONNECT4_ prefix and SCREAMING_SNAKE_CASE. Examples:
# CONNECT4_ELO_K_FACTOR=24
# CONNECT4_GAME_RUNNER_PACING_SECONDS=0.5
# CONNECT4_RATE_LIMIT_SNOOZE_SECONDS=300
# CONNECT4_TOURNAMENT_WATCHER_HEARTBEAT_SECONDS=15
# CONNECT4_DEFAULT_TEMPERATURE=0.0
# CONNECT4_FALLBACK_MODEL=gpt-4o
